{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "org.optics-framework/optics",
  "title": "Optics",
  "version": "1.11.5",
  "description": "Drive Android, iOS, TV, desktop and web apps from an AI agent. Runs locally: `optics mcp`.",
  "websiteUrl": "https://optics-framework.org/docs/reference/mcp",
  "repository": {
    "url": "https://github.com/mozarkai/optics-framework",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://optics-framework.org/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://127.0.0.1:{port}/mcp",
      "variables": {
        "port": {
          "description": "The --port given to `optics mcp --transport http`.",
          "format": "number",
          "default": "8090"
        }
      }
    }
  ],
  "_meta": {
    "org.optics-framework/local": {
      "install": "pip install \"optics-framework[mcp]\"",
      "stdio": {
        "command": "optics",
        "args": [
          "mcp"
        ]
      },
      "register": "optics mcp install"
    }
  },
  "serverInfo": {
    "name": "Optics MCP",
    "version": "1.11.5"
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "http://127.0.0.1:8090/mcp"
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false
  },
  "tools": [
    {
      "name": "start_session",
      "description": "Start a session on a desktop app, a phone or a browser; returns its id and the first screen.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "terminate_session",
      "description": "End a session.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "observe",
      "description": "List the screen as rows with refs, to read or search the page.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "tap",
      "description": "Tap, click or press an element by ref, label or locator.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "type_text",
      "description": "Type, enter or fill text into a field; for several fields use batch.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "scroll",
      "description": "Scroll or swipe the screen, or until a text shows.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "press_key",
      "description": "Press a key: back, Enter, Escape or a device key.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "launch_app",
      "description": "Open an app, or navigate the browser to a URL.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "batch",
      "description": "Run several tap, type_text and press_key steps in one call, such as filling a form; stops at the first failure.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "check",
      "description": "Verdict on what is on the screen: assert or verify texts.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "run_keyword",
      "description": "Run another optics keyword when no other tool does the job, such as select_dropdown_option.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
  ]
}
